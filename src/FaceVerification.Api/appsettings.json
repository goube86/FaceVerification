{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FaceVerification": "Host=localhost;Port=5432;Database=face_verification;Username=face_verification;Password=change-me"
  },
  "Authentication": {
    "Authority": "",
    "Audience": "face-verification-api",
    "EnableDevelopmentIdentity": false
  },
  "OpenApi": { "Enabled": false },
  "Verification": {
    "MatchThreshold": 0.55,
    "NonMatchThreshold": 0.35,
    "SessionLifetimeMinutes": 5,
    "MaxFileSizeBytes": 5242880,
    "MaxWidth": 4096,
    "MaxHeight": 4096,
    "MaxPixels": 16000000,
    "MinimumFacePixels": 80,
    "InferenceTimeoutSeconds": 15,
    "MaxConcurrentInferences": 2,
    "MinimumQualityScore": 0.45,
    "AbandonedProcessingMinutes": 5,
    "RetentionDays": 30,
    "BypassSessionValidation": false
  },
  "Models": {
    "YuNetManifest": "yunet/manifest.json",
    "SFaceManifest": "sface/manifest.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
